{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/sg/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sg/",
      "destination": "/index.html"
    },
    {
      "source": "/sg/ip-transit-singapore/",
      "destination": "/ip-transit-singapore.html"
    },
    {
      "source": "/sg/dedicated-internet-access-singapore/",
      "destination": "/dedicated-internet-access-singapore.html"
    },
    {
      "source": "/sg/leased-line-singapore/",
      "destination": "/leased-line-singapore.html"
    },
    {
      "source": "/sg/network-coverage-singapore/",
      "destination": "/network-coverage-singapore.html"
    },
    {
      "source": "/sg/cisco-network-solutions/",
      "destination": "/cisco-network-solutions.html"
    },
    {
      "source": "/sg/multiple-services-connectivity-singapore/",
      "destination": "/multiple-services-connectivity-singapore.html"
    },
    {
      "source": "/sg/cisco-duo-singapore/",
      "destination": "/cisco-duo-singapore.html"
    }
  ]
}
